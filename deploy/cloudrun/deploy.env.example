# Copy to deploy.env and fill in. deploy.env is gitignored.
#
# These are non-secret configuration values. Real secrets — APP_KEY, DB_PASSWORD,
# MAIL_PASSWORD, AWS_SECRET_ACCESS_KEY — are NOT here: the manifests read those
# from Secret Manager. Add them there instead, e.g.
#
#   printf '%s' 'value' | gcloud secrets versions add APP_KEY --data-file=- --project=invoiceink
#
# Every value below should match what the VPS app.env uses today, so the migration
# is a move rather than a reconfiguration.

PROJECT=invoiceink
REGION=asia-south1
TAG=manual-403fbd47

# External MySQL, reached over the public internet with TLS.
# DigitalOcean managed MySQL listens on 25060, not the default 3306.
DB_HOST=
DB_PORT=25060
DB_NAME=
DB_USER=

# Optional. Path INSIDE the container to a CA bundle for verifying the database
# server certificate. Leave blank to connect over TLS without verifying the
# server cert (which is what the VPS does today); the env entry is then omitted
# entirely rather than set to an empty string.
DB_SSL_CA=

# AWS S3 proper — no endpoint override, no path-style addressing.
AWS_KEY_ID=
AWS_REGION=
AWS_BUCKET=
AWS_URL=

# SMTP. MAIL_PASSWORD comes from Secret Manager, not from here.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_FROM=

# Needed by BOTH manifests — the worker sets CLOUD_TASKS_HANDLER too, so a job
# dispatched from within a job lands back on the worker rather than the public
# service.
#
# Chicken-and-egg on the very first deploy: Cloud Run only assigns the URL once
# the service exists. Bootstrap the worker with a placeholder, then read the real
# value back and re-render both:
#
#   WORKER_URL=https://placeholder.invalid ./render.sh worker > /tmp/worker.yaml
#   gcloud run services replace /tmp/worker.yaml --region=asia-south1
#   gcloud run services describe invoicing-worker --region=asia-south1 \
#     --project=invoiceink --format='value(status.url)'
WORKER_URL=

# Staging (mcp-staging.yaml). A SEPARATE schema on the same MySQL server, with a
# dedicated least-privilege account granted only on that schema — never the
# production database or the production user. APP_KEY and DB_PASSWORD for staging
# are distinct secrets (APP_KEY_STAGING, DB_PASSWORD_STAGING) so a compromise of
# a lower-trust environment does not yield production's.
#
# CI reads these from the repository variables GCP_STAGING_DB_NAME and
# GCP_STAGING_DB_USER instead; keep the two in step.
STAGING_DB_NAME=
STAGING_DB_USER=

# Optional, and filled in automatically by the deploy workflow. Same
# chicken-and-egg as WORKER_URL: Cloud Run assigns the URL only once the service
# exists, so the first render omits APP_URL and the second supplies it.
STAGING_URL=
